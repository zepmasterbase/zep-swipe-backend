<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zep OS 3.5 Admin Control</title>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
:root{
  --bg: radial-gradient(circle at 20% 10%, #120018, #000);
  --glass: rgba(255,255,255,0.06);
  --stroke: rgba(255,255,255,0.12);
  --pink:#ff4fd8;
  --purple:#9c4dff;
  --blue:#00f0ff;
  --text: rgba(255,255,255,0.85);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Poppins;
}

body{
  background:var(--bg);
  color:white;
}

/* HEADER */
header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:14px 16px;
  border-bottom:1px solid var(--stroke);
  background:rgba(255,255,255,0.03);
}

.logo{
  font-family:Orbitron;
  background:linear-gradient(90deg,var(--pink),var(--purple),var(--blue));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}

/* LAYOUT */
.container{
  max-width:1100px;
  margin:auto;
  padding:16px;
  display:grid;
  gap:16px;
}

/* CARDS */
.card{
  background:var(--glass);
  border:1px solid var(--stroke);
  border-radius:14px;
  padding:16px;
}

/* GRID */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:12px;
}

/* METRICS */
.metric{
  padding:12px;
  border-radius:12px;
  background:rgba(0,0,0,0.3);
  border:1px solid rgba(255,255,255,0.08);
}

/* TABLE */
table{
  width:100%;
  border-collapse:collapse;
  font-size:13px;
}

th,td{
  padding:10px;
  border-bottom:1px solid rgba(255,255,255,0.08);
  text-align:left;
}

/* AI BOX */
.ai{
  background:rgba(0,240,255,0.08);
  border:1px solid rgba(0,240,255,0.2);
  padding:12px;
  border-radius:12px;
  font-size:13px;
}

/* BUTTON */
button{
  padding:8px 12px;
  border:none;
  border-radius:8px;
  cursor:pointer;
  font-family:Orbitron;
  background:linear-gradient(90deg,var(--pink),var(--purple));
  color:black;
}
</style>
</head>

<body>

<header>
  <div class="logo">⚡ Zep Admin OS 3.5</div>
  <button onclick="logout()">Logout</button>
</header>

<div class="container">

<!-- AI INSIGHT -->
<div class="ai" id="aiBox">
🤖 AI Insight: Initializing admin analytics...
</div>

<!-- COUNTRY + ROLE -->
<div class="card">
  <h3>Admin Identity</h3>
  <div class="grid">
    <div class="metric">Country: <span id="adminCountry">Loading...</span></div>
    <div class="metric">Role: <span id="adminRole">Loading...</span></div>
    <div class="metric">Device Session: <span id="deviceId">Loading...</span></div>
  </div>
</div>

<!-- STATS -->
<div class="card">
  <h3>Country Overview</h3>
  <div class="grid">
    <div class="metric">Users: <span id="usersCount">0</span></div>
    <div class="metric">Wallet Volume: $<span id="walletSum">0</span></div>
    <div class="metric">Active Learners: <span id="activeLearners">0</span></div>
    <div class="metric">Today Signups: <span id="todaySignups">0</span></div>
  </div>
</div>

<!-- USERS -->
<div class="card">
  <h3>Users (Country Scoped)</h3>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Country</th>
        <th>XP</th>
      </tr>
    </thead>
    <tbody id="usersTable"></tbody>
  </table>
</div>

</div>

<script type="module">
import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm";

const supabase = createClient("YOUR_SUPABASE_URL","YOUR_SUPABASE_ANON_KEY");

/* ================= STATE ================= */
let admin = null;
let adminCountry = null;

/* DEVICE ID */
function getDeviceId(){
  let id = localStorage.getItem("zep_admin_device");
  if(!id){
    id = crypto.randomUUID();
    localStorage.setItem("zep_admin_device", id);
  }
  return id;
}

/* SESSION CHECK */
async function loadAdmin(){

  const { data } = await supabase.auth.getUser();

  if(!data.user){
    location.href = "login-sign.html";
    return;
  }

  admin = data.user;

  adminCountry = admin.user_metadata?.country || "Unknown";

  document.getElementById("adminCountry").innerText = adminCountry;
  document.getElementById("adminRole").innerText = admin.user_metadata?.role || "admin";
  document.getElementById("deviceId").innerText = getDeviceId();

  loadAnalytics();
  loadUsers();
}

loadAdmin();

/* ================= ANALYTICS ================= */
async function loadAnalytics(){

  const { data: users } = await supabase
    .from("users")
    .select("*")
    .eq("country", adminCountry);

  const { data: wallets } = await supabase
    .from("wallets")
    .select("*");

  document.getElementById("usersCount").innerText = users?.length || 0;

  let sum = 0;
  wallets?.forEach(w => sum += (w.balance || 0));

  document.getElementById("walletSum").innerText = sum.toFixed(2);

  document.getElementById("activeLearners").innerText =
    Math.floor((users?.length || 0) * 0.6);

  document.getElementById("todaySignups").innerText =
    Math.floor((users?.length || 0) * 0.1);

  document.getElementById("aiBox").innerText =
    `🤖 AI Insight: ${adminCountry} ecosystem is stable with ${(users?.length||0)} users active. Growth trend positive.`;
}

/* ================= USERS ================= */
async function loadUsers(){

  const { data } = await supabase
    .from("users")
    .select("*")
    .eq("country", adminCountry)
    .limit(50);

  const table = document.getElementById("usersTable");
  table.innerHTML = "";

  data?.forEach(u=>{
    const row = document.createElement("tr");

    row.innerHTML = `
      <td>${u.full_name || "-"}</td>
      <td>${u.email}</td>
      <td>${u.country}</td>
      <td>${u.xp || 0}</td>
    `;

    table.appendChild(row);
  });
}

/* ================= LOGOUT ================= */
async function logout(){
  await supabase.auth.signOut();
  localStorage.clear();
  location.href = "login-sign.html";
}
</script>

</body>
</html>